# AI Agent City — Grand Line Command Center Environment Configuration

# Backend Application Configuration
APP_ENV=development
DEBUG=True
API_HOST=127.0.0.1
API_PORT=8000
DATABASE_URL=sqlite:///./agency.db

# Cryptographic Signing Secret
# MANDATORY: 32+ byte cryptographically secure random key.
# The server will fail securely to start if this is missing, empty, shorter than 32 bytes,
# or set to a known development/default value.
# Provision securely via: openssl rand -hex 32
SECRET_KEY=replace_with_a_secure_random_32_byte_secret_via_openssl

# CORS Allowed Origins (Comma-separated or list)
FRONTEND_ORIGIN=http://localhost:3000

# Frontend Environment Variables (apps/web or frontend/)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# ==========================================================
# Milestone 4 — AI Agent Runtime & LLM Provider Settings
# ==========================================================
# Provider options: 'deterministic' (offline zero-cost default), 'openai', 'ollama'
LLM_PROVIDER=deterministic
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=
LLM_BASE_URL=
LLM_TIMEOUT_SECONDS=60

# Runtime Execution Bounds
MAX_EXECUTION_ITERATIONS=10
MAX_TOOL_CALLS=15
MAX_PLAN_STEPS=8
MAX_FILE_READ_BYTES=102400

# Task Dispatcher & Background Worker
DISPATCHER_ENABLED=True
DISPATCHER_POLL_INTERVAL=1.0
