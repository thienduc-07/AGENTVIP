# AI Agency — Autonomous Business Headquarters Environment Configuration

# Backend Application Configuration
APP_ENV=development
DEBUG=True
API_HOST=127.0.0.1
API_PORT=8000
DATABASE_URL=sqlite:///./agency.db

# Cryptographic Signing Secret
# MANDATORY: 32+ byte cryptographically secure random key.
# The server will fail securely to start if this is missing, empty, shorter than 32 bytes,
# or set to a known development/default value.
# Provision securely via: openssl rand -hex 32
SECRET_KEY=replace_with_a_secure_random_32_byte_secret_via_openssl

# CORS Allowed Origins (Comma-separated or list)
FRONTEND_ORIGIN=http://localhost:3000

# Frontend Environment Variables (frontend/)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_ENABLE_DEMO_SIMULATION=false

# ==========================================================
# Phase 3.3.3.6 — Live LLM Provider & Runtime Settings
# ==========================================================
# Supported LLM_PROVIDER values:
# - deterministic : Offline deterministic test engine (never counts as live LLM execution)
# - openai        : OpenAI API or any OpenAI-compatible cloud endpoint
# - groq          : Groq Cloud OpenAI-compatible endpoint (https://api.groq.com/openai/v1)
# - openrouter    : OpenRouter OpenAI-compatible endpoint (https://openrouter.ai/api/v1)
# - gemini        : Google Gemini OpenAI-compatible endpoint (https://generativelanguage.googleapis.com/v1beta/openai)
# - ollama        : Local Ollama server (default http://localhost:11434)
LLM_PROVIDER=deterministic
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=
LLM_BASE_URL=
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2
LLM_RETRY_BASE_DELAY_SECONDS=0.5

# Optional Provider-Specific Credential / Endpoint Overrides
OPENAI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
GEMINI_API_KEY=
GOOGLE_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# ==========================================================
# Phase 3.3.3.8 & 3.3.3.10 — Hybrid LLM Routing & Zero-Cost Deployment
# ==========================================================
LLM_ROUTING_MODE=hybrid

LLM_LOCAL_PROVIDER=ollama
LLM_LOCAL_BASE_URL=http://localhost:11434
LLM_LOCAL_MODEL=

LLM_CLOUD_PROVIDER=openrouter
LLM_CLOUD_MODEL=google/gemma-4-31b-it:free
# Primary verified $0 OpenRouter free model:
# - google/gemma-4-31b-it:free       (262k ctx, native tools + response_format, $0.00/$0.00 per 1M)
# Legacy/optional reference setting: LLM_ALLOW_CLOUD_FALLBACK=true
# Zero-cost fail-closed policy disables paid cloud fallback:
LLM_ALLOW_CLOUD_FALLBACK=false
LLM_ZERO_COST_POLICY=true

MAX_TASK_CLOUD_COST_USD=0.10
MAX_ORGANIZATION_DAILY_CLOUD_COST_USD=1.00
MAX_ORGANIZATION_MONTHLY_CLOUD_COST_USD=20.00
MAX_TASK_CLOUD_REQUESTS=10
MAX_ORGANIZATION_DAILY_CLOUD_REQUESTS=200
LLM_MAX_CONCURRENT_REQUESTS=2
MAX_TOKENS_PER_REQUEST=4096
LLM_HEALTH_CHECK_INTERVAL_SECONDS=30.0
LLM_HEALTH_CHECK_TIMEOUT_SECONDS=5.0
LLM_HEALTH_FAILURE_THRESHOLD=3

# Runtime Execution, Token, Cost & Duration Bounds
MAX_EXECUTION_ITERATIONS=10
MAX_TOOL_CALLS=15
MAX_PLAN_STEPS=8
MAX_FILE_READ_BYTES=102400
MAX_TASK_TOKENS=32000
MAX_TASK_COST_USD=0.50
MAX_TASK_EXECUTION_SECONDS=180.0

# Task Dispatcher & Background Worker
DISPATCHER_ENABLED=True
DISPATCHER_POLL_INTERVAL=1.0

# Autonomous CEO Supervisory Heartbeat (Safely disabled by default in dev/test)
CEO_HEARTBEAT_ENABLED=False
CEO_HEARTBEAT_AGENT_ID=agent-exec-ceo
CEO_HEARTBEAT_INTERVAL_SECONDS=60.0
CEO_HEARTBEAT_TIMEOUT_SECONDS=25.0
CEO_HEARTBEAT_STALLED_TASK_THRESHOLD_SECONDS=300.0
CEO_HEARTBEAT_OVERDUE_TASK_THRESHOLD_SECONDS=900.0
CEO_HEARTBEAT_MAX_TOKENS_PER_RUN=2000
CEO_HEARTBEAT_MAX_COST_USD_PER_RUN=0.05
CEO_HEARTBEAT_DAILY_TOKEN_BUDGET=100000
CEO_HEARTBEAT_DAILY_COST_BUDGET_USD=2.00
CEO_HEARTBEAT_REQUIRE_APPROVAL_FOR_REASSIGNMENT=True
